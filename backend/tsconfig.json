{
    "compilerOptions": {
        "rootDir": "src",
        "outDir": "dist",
        "target": "ES6",
        "module": "CommonJS",
        "strict": true,
        "skipLibCheck": true,
        "removeComments": true,
        "esModuleInterop": true,
        "paths": {
            "@/*": [
                "./src/*"
            ]
        }
    },
    "include": [
        "src/**/*"
    ]
}
